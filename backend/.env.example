# ScoutSpark Backend Environment Configuration Example
# Copy this file to backend/.env for local development, or configure these variables in Render dashboard.
# NEVER commit your real backend/.env or secret keys to Git!

# Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Tavily Search API Configuration
# Get your API key from Tavily: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Research Mode: 'live' for real public-web Tavily + Gemini runs, or 'demo'
SCOUTSPARK_RESEARCH_MODE=live

# CORS Configuration
# Comma-separated list or JSON array of allowed origins (e.g. your Vercel deployment URL)
CORS_ORIGINS=https://your-scoutspark-frontend.vercel.app,http://localhost:5173

# Database Configuration (Optional)
# Defaults to local SQLite at backend/scoutspark.db.
# For persistent production storage on Render, provide a PostgreSQL connection URL:
# DATABASE_URL=postgresql://user:password@host/database_name
# Or SQLite on a Render Persistent Disk:
# DATABASE_URL=sqlite:////var/data/scoutspark.db

